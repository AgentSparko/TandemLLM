# the build context is app/; the image needs pyproject.toml, VERSION, MANIFEST.in, the license
# files, docs/proxy.md, proxy/, chatd/, tandemapp/, packages/ and dashboard/dist/ only
*
!pyproject.toml
!VERSION
!MANIFEST.in
!LICENSE
!COMMERCIAL-LICENSE.md
!NOTICE
!docs/proxy.md
!proxy/
!chatd/
!tandemapp/
!packages/
!dashboard/dist/
**/__pycache__
