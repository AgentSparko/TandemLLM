{
 "version": "1.3",
 "form": "xml",
 "about": "callrepair's argument renames and tool mappings (engine API 1.3), on calls in the xml form: check.py runs them with repair on; both copies must answer every case's want.",
 "tool_sets": {
  "coding": [
   {
    "type": "function",
    "function": {
     "name": "read",
     "parameters": {
      "type": "object",
      "properties": {
       "filePath": {
        "type": "string"
       },
       "offset": {
        "type": "number"
       },
       "limit": {
        "type": "number"
       }
      },
      "required": [
       "filePath"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "write",
     "parameters": {
      "type": "object",
      "properties": {
       "content": {
        "type": "string"
       },
       "filePath": {
        "type": "string"
       }
      },
      "required": [
       "content",
       "filePath"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "bash",
     "parameters": {
      "type": "object",
      "properties": {
       "command": {
        "type": "string"
       },
       "description": {
        "type": "string"
       }
      },
      "required": [
       "command"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "grep",
     "parameters": {
      "type": "object",
      "properties": {
       "pattern": {
        "type": "string"
       },
       "path": {
        "type": "string"
       }
      },
      "required": [
       "pattern"
      ]
     }
    }
   }
  ],
  "bash_only": [
   {
    "type": "function",
    "function": {
     "name": "bash",
     "parameters": {
      "type": "object",
      "properties": {
       "command": {
        "type": "string"
       },
       "description": {
        "type": "string"
       }
      },
      "required": [
       "command"
      ]
     }
    }
   }
  ],
  "two_paths": [
   {
    "type": "function",
    "function": {
     "name": "copy",
     "parameters": {
      "type": "object",
      "properties": {
       "src_path": {
        "type": "string"
       },
       "dst_path": {
        "type": "string"
       }
      },
      "required": [
       "src_path",
       "dst_path"
      ]
     }
    }
   }
  ]
 },
 "cases": [
  {
   "id": "path-to-filePath",
   "text": "<tool_call>\n<function=read>\n<parameter=path>\n/tmp/proj/src/config.py\n</parameter>\n</function>\n</tool_call>",
   "eos": true,
   "tools": "coding",
   "names": true,
   "types": "schema",
   "repair": true,
   "stream": [
    1,
    5,
    0
   ],
   "want": {
    "content": "",
    "calls": [
     {
      "name": "read",
      "arguments": "{\"filePath\": \"/tmp/proj/src/config.py\"}"
     }
    ],
    "renames": [
     {
      "kind": "argument",
      "tool": "read",
      "from": "path",
      "to": "filePath"
     }
    ],
    "stream": {
     "content": "",
     "calls": [
      {
       "name": "read",
       "arguments": "{\"filePath\": \"/tmp/proj/src/config.py\"}"
      }
     ]
    }
   }
  },
  {
   "id": "case-and-underscore",
   "text": "<tool_call>\n<function=read>\n<parameter=file_path>\n/a.py\n</parameter>\n<parameter=offset>\n10\n</parameter>\n</function>\n</tool_call>",
   "eos": true,
   "tools": "coding",
   "names": true,
   "types": "schema",
   "repair": true,
   "stream": [
    1,
