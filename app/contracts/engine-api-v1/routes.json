  "engine_screens_until_eng413": [
    {
      "method": "GET",
      "path": "/v1/conductor/residency/plan",
      "schema": "../conductor-v1/residency-plan.schema.json",
      "handler": "inproc.ROUTES[residency_plan]",
      "tandem_app": "404 not_found, routes.ENGINE_ONLY",
      "group": 9
    },
    {
      "method": "GET",
      "path": "/v1/conductor/memory/disk",
      "schema": "../conductor-v1/memory-disk.schema.json",
      "handler": "inproc.ROUTES[disk]",
      "tandem_app": "404 not_found, routes.ENGINE_ONLY",
      "group": 9
    },
    {
      "method": "POST",
      "path": "/v1/conductor/memory/disk/clear",
      "schema": "../conductor-v1/memory-disk-clear.schema.json",
      "handler": "inproc.ROUTES[disk]",
      "tandem_app": "404 not_found, routes.ENGINE_ONLY",
      "group": 9
    },
    {
      "method": "*",
      "path": "/v1/conductor/deciders/*",
      "schema": "../conductor-v1/deciders-status.schema.json",
      "handler": "inproc.ROUTES[deciders]",
      "tandem_app": "status: 200, enabled false, why routes.DECIDERS_OFF_WHY; the rest 404 not_found with that text",
      "group": 9
    },
    {
      "method": "*",
      "path": "/v1/conductor/narrator/*",
      "handler": "the narrator inproc.start_narrator starts (state narrator)",
      "tandem_app": "status: 200, the narrator off; the rest 404 not_found (narrator.OFF_WHY)",
      "group": 9
    },
    {
      "method": "*",
      "path": "/v1/conductor/shadow/*",
      "handler": "the shadow reader server/conductor/shadow.py start() runs (state shadow)",
      "tandem_app": "status: 200, enabled false, why routes.SHADOW_OFF_WHY; the rest 404 not_found with that text",
      "group": 9
    }
  ],
  "app_routes_via_engine": [
    {
      "path": "/v1/conductor/*",
      "except": [
        "/v1/conductor/residency/plan",
        "/v1/conductor/memory/disk",
        "/v1/conductor/memory/disk/clear",
        "/v1/conductor/deciders/*",
        "/v1/conductor/narrator/*",
        "/v1/conductor/shadow/*"
      ],
      "contract": "../conductor-v1/",
      "doc": "TandemApp's conductor, run in the engine's process"
    },
    {
