    },
    {
      "path": "/s/{token}/*",
      "contract": null,
      "doc": "a session address: /v1/library, /v1/laya and /v1/memory under the session's token (tandemapp/session_tokens.py)"
    },
    {
      "path": "/dashboard/*",
      "contract": null,
      "doc": "the dashboard's built files (the not-built page without them)"
    }
  ],
  "app_families": [
    {
      "path": "/v1/fleet/*",
      "contract": "../fleet-v1",
      "doc": "the controller's fleet API; never the engine"
    }
  ],
  "shared_prefixes": {
    "/v1/dashboard": [
      "routes",
      "app_routes_via_engine"
    ]
  }
