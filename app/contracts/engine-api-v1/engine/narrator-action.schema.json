{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "engine narrator action",
  "description": "POST /v1/engine/narrator/load (202 started or queued behind the decision models, 409 the role is off or the planner refused it), /unload (200), /try (200: the lines a list of events gives, and the slot) (ENG-413 WP5)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state": {
      "type": "string"
    },
    "queued": {
      "type": "boolean"
    },
    "decision": {
      "type": "object"
    },
    "lines": {
      "type": "array"
    },
    "slot": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
