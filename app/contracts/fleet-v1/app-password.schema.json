{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/app-password.schema.json",
  "title": "GET, PUT and DELETE /v1/fleet/app/password (200): whether an admin password is set (a password set here, the admin token from the env file, or both), when, its length limits and whether this request comes from the controller's own machine; PUT and DELETE also set this browser's new session cookie",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "set": {
      "type": "boolean"
    },
    "password": {
      "type": "boolean"
    },
    "token": {
      "type": "boolean"
    },
    "set_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "min_length": {
      "type": "integer"
    },
    "max_length": {
      "type": "integer"
    },
    "this_machine": {
      "type": "boolean"
    }
  },
  "required": [
    "contract_version",
    "set",
    "password",
    "token",
    "set_at",
    "min_length",
    "max_length",
    "this_machine"
  ],
  "additionalProperties": false
}
