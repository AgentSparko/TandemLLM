{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/deployment-plan.schema.json",
  "title": "GET /v1/fleet/deployments/{id}/actions/{start|stop|move}[?from=&to=&engine=] (200): what the action does, whether it may, its confirm",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "deployment": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "start",
        "stop",
        "move"
      ]
    },
    "title": {
      "type": "string"
    },
    "allowed": {
      "type": "boolean"
    },
    "blocked": {
      "type": [
        "string",
        "null"
      ]
    },
    "destructive": {
      "type": "boolean"
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keeps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirm": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "job": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "start",
            "stop",
            "move"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "done",
            "failed"
          ]
        },
        "started_at": {
          "type": "number"
        },
        "ended_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "error": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "action",
        "state",
        "started_at",
        "ended_at",
        "text",
        "error"
      ],
      "additionalProperties": false
    },
    "from": {
      "type": [
        "string",
        "null"
      ]
    },
    "to": {
      "type": [
        "string",
        "null"
      ]
    },
    "engine": {
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "deployment",
    "action",
    "title",
    "allowed",
    "blocked",
    "destructive",
    "impact",
    "keeps",
    "confirm",
    "expires_at",
    "job",
    "from",
    "to"
  ],
  "additionalProperties": false
}
