{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/session.schema.json",
  "title": "GET /v1/fleet/session (200): whether an admin password is set and this browser is signed in to the controller",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "password_set": {
      "type": "boolean"
    },
    "authenticated": {
      "type": "boolean"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "contract_version",
    "password_set",
    "authenticated",
    "expires_at"
  ],
  "additionalProperties": false
}
