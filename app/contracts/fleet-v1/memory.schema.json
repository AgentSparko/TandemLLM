{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/memory.schema.json",
  "title": "GET /v1/fleet/memory (200): the unified memory split per reporting node, GiB",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "unit": {
      "type": "string",
      "enum": [
        "GiB"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string"
          },
          "weights": {
            "type": "number"
          },
          "kv": {
            "type": "number"
          },
          "cache": {
            "type": "number"
          },
          "other": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "ceiling": {
            "type": "number"
          },
          "peak": {
            "type": "number"
          },
          "usable": {
            "type": "number"
          }
        },
        "required": [
          "node",
          "weights",
          "kv",
          "cache",
          "other",
          "page",
          "ceiling",
          "peak",
          "usable"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "unit",
    "nodes"
  ],
  "additionalProperties": false
}
