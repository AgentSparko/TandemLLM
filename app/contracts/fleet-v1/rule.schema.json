{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/rule.schema.json",
  "title": "PATCH /v1/fleet/rules/{id} (200): the rule as changed",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "condition": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "notify": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "app",
          "system"
        ]
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "threshold": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "for_s": {
      "type": "number"
    },
    "severity": {
      "type": "string",
      "enum": [
        "warn",
        "err"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "metric",
    "condition",
    "scope",
    "notify",
    "enabled",
    "threshold",
    "unit",
    "for_s",
    "severity"
  ],
  "additionalProperties": false
}
