{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/weights-job.schema.json",
  "title": "POST /v1/fleet/weights/copy, GET /v1/fleet/weights/copy/{id} and POST .../stop (200): the copy's job",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "weights"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "done",
            "failed",
            "stopped"
          ]
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "from_alias": {
          "type": "string"
        },
        "to_alias": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "via": {
          "type": "string",
          "enum": [
            "direct",
            "relay"
          ]
        },
        "via_why": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "started_at": {
          "type": "number"
        },
        "ended_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "bytes_total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "bytes_done": {
          "type": "integer"
        },
        "files_total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "files_done": {
          "type": "integer"
        },
        "rate_gbps": {
          "type": [
            "number",
            "null"
          ]
        },
        "content_id": {
          "type": "object",
          "properties": {
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "expected": {
              "type": [
                "string",
                "null"
              ]
            },
            "copy": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "source",
            "expected",
            "copy"
          ],
          "additionalProperties": false
        },
        "verified": {
          "type": "boolean"
        },
        "log": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t": {
                "type": "number"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "t",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "error": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "from",
        "to",
        "from_alias",
        "to_alias",
        "profile",
        "via",
        "via_why",
        "by",
        "started_at",
        "ended_at",
        "bytes_total",
        "bytes_done",
        "files_total",
        "files_done",
        "rate_gbps",
        "content_id",
        "verified",
        "log",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "job"
  ],
  "additionalProperties": false
}
