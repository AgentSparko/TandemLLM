  "$id": "https://qwen38-spark-engine/contract/fleet-v1/add-link.schema.json",
  "title": "the body of POST /v1/fleet/add/{id}/link: test the new nodes' links, skip, or configure the fabric (sudo, asked per action)",
  "type": "object",
