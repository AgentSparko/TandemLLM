{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/rules.schema.json",
  "title": "GET /v1/fleet/rules (200): the alert rules",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "notify": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "app",
                "system"
              ]
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "for_s": {
            "type": "number"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warn",
              "err"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "metric",
          "condition",
          "scope",
          "notify",
          "enabled",
          "threshold",
          "unit",
          "for_s",
          "severity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "rules"
  ],
  "additionalProperties": false
}
