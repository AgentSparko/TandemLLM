{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/node.schema.json",
  "title": "GET and PATCH /v1/fleet/nodes/{id} (200): one node",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "alias": {
      "type": "string"
    },
    "colour": {
      "type": "integer",
      "minimum": 1
    },
    "icon": {
      "type": "string",
      "enum": [
        "desk",
        "cloud",
        "rack"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "class": {
      "type": "string",
      "enum": [
        "spark",
        "backend"
      ]
    },
    "hw": {
      "type": "string"
    },
    "dmi": {
      "type": "string"
    },
    "owned": {
      "type": "boolean"
    },
    "transport": {
      "type": "string",
      "enum": [
        "lan",
        "tunnel"
      ]
    },
    "address": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "up",
        "draining",
        "off",
        "alert"
      ]
    },
    "status_text": {
      "type": "string"
    },
    "since": {
      "type": "number"
    },
    "lease_end": {
      "type": [
        "number",
        "null"
      ]
    },
    "cost_per_hour": {
      "type": [
        "number",
        "null"
      ]
    },
    "inventory": {
      "type": "object",
      "properties": {
        "serial": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "kernel": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver": {
          "type": [
            "string",
            "null"
          ]
        },
        "cuda": {
          "type": [
            "string",
            "null"
          ]
        },
        "cx7": {
          "type": [
            "string",
            "null"
          ]
        },
        "disk": {
          "type": [
            "string",
            "null"
          ]
        },
        "nics": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "serial",
        "os",
        "kernel",
        "driver",
        "cuda",
        "cx7",
        "disk",
        "nics"
      ],
      "additionalProperties": false
    },
    "pairing": {
      "type": "object",
      "description": "how the controller trusts the node (SEC-4): this machine, paired by code or SSH once, or not paired yet",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "local",
            "paired",
            "unpaired"
          ]
        },
        "via": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "code",
            "ssh",
            null
          ]
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "description": "SHA-256 of the node's pinned certificate, hex"
        },
        "paired_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "host_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "the SSH host key's fingerprint (SHA256:...) a pairing by SSH confirmed"
        }
      },
      "required": [
        "state",
        "via",
        "fingerprint",
        "paired_at",
        "host_key"
      ],
      "additionalProperties": false
    },
    "drain": {
      "type": [
        "object",
        "null"
      ],
      "description": "maintenance (VIS-250): no new requests through the gateway; `draining` while requests are in flight, then `drained`; null when the node takes requests",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "draining",
            "drained"
          ]
        },
        "since": {
          "type": "number"
        },
        "by": {
          "type": [
            "string",
            "null"
          ]
        },
        "inflight": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "state",
        "since",
        "by",
        "inflight"
      ],
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "description": "SRV-749: the backend behind a member of class backend: what the OpenAI-compatible surface and this gateway say of it. Never its API key.",
      "properties": {
        "id": {
          "type": "string",
          "description": "the backend's id in the config database (/v1/config/backends/{id})"
        },
        "kind": {
          "type": "string"
        },
        "cloud": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "key_set": {
          "type": "boolean",
          "description": "whether an API key is stored for it; the key itself is in no answer"
        },
        "state": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "key_rejected",
            "unknown",
            "disabled"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the model ids it serves through this gateway"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the OpenAI routes its adapter relays"
        },
        "figures": {
          "type": "string",
          "enum": [
            "own",
            "gateway"
          ],
          "description": "where its tok/s, requests and TTFT come from: its own metrics page, or what this gateway measured of the requests it relayed (requests in flight and TTFT only)"
        },
        "engine_api": {
          "type": [
            "object",
            "null"
          ],
          "description": "a TandemLLM engine reached by URL: the engine API its /health says (proxy/engineapi.py); null for any other kind and before the first answer",
          "properties": {
            "engine_api": {
              "type": "string"
            },
            "assumed": {
              "type": "boolean"
            },
            "ok": {
              "type": "boolean"
            },
            "why": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "engine_api",
            "assumed",
            "ok",
            "why"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "cloud",
        "url",
        "key_set",
        "state",
        "error",
        "latency_ms",
        "models",
        "routes",
        "figures",
        "engine_api"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "alias",
    "colour",
    "icon",
    "tags",
    "class",
    "hw",
    "dmi",
    "owned",
    "transport",
    "address",
    "version",
    "status",
    "status_text",
    "since",
    "lease_end",
    "cost_per_hour",
    "inventory",
    "pairing",
    "drain"
  ],
  "additionalProperties": false
}
