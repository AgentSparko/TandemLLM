{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/app.schema.json",
  "title": "GET /v1/fleet/app (200; POST /v1/fleet/app/permissions/local-network answers it too): App settings' state: each permission the controller can read (A14), how it runs as a service, what an export holds, the admin password's state",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "platform": {
      "enum": [
        "mac",
        "linux"
      ]
    },
    "release": {
      "type": [
        "string",
        "null"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "local_network",
              "keys",
              "notifications",
              "node_sudo"
            ]
          },
          "title": {
            "type": "string"
          },
          "applies": {
            "type": "boolean"
          },
          "state": {
            "enum": [
              "granted",
              "lan_denied",
              "not_asked",
              "not_applicable",
              "unknown",
              "file",
              "too_open",
              "keychain",
              "in_browser",
              "per_action"
            ]
          },
          "why": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "fallback": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "check",
                  "browser"
                ]
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "label"
            ],
            "additionalProperties": false
          },
          "settings": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "what": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "mode": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "enum": [
                    "ok",
                    "too_open",
                    "missing",
                    "unknown"
                  ]
                }
              },
              "required": [
                "what",
                "path",
                "mode",
                "state"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "applies",
          "state",
          "why",
          "detail",
          "fallback",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "manager": {
          "enum": [
            "systemd",
            "launchd",
            "none",
            "unknown"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "starts_at_boot": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "restarts": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "linger": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "manager",
        "unit",
        "starts_at_boot",
        "restarts",
        "linger",
        "text"
      ],
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "tandemapp-fleet-config"
        },
        "version": {
          "const": 1
        },
        "secrets": {
          "const": "excluded"
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "version",
        "secrets",
        "excluded"
      ],
      "additionalProperties": false
    },
    "password": {
      "type": "object",
      "properties": {
        "set": {
          "type": "boolean"
        },
        "password": {
          "type": "boolean"
        },
        "token": {
          "type": "boolean"
        },
        "set_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "min_length": {
          "type": "integer"
        },
        "max_length": {
          "type": "integer"
        },
        "this_machine": {
          "type": "boolean"
        }
      },
      "required": [
        "set",
        "password",
        "token",
        "set_at",
        "min_length",
        "max_length",
        "this_machine"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "platform",
    "release",
    "permissions",
    "service",
    "export",
    "password"
  ],
  "additionalProperties": false
}
