{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/handover.schema.json",
  "title": "POST /v1/fleet/controller/handover {certificate, name, api_url} (200): the giver's export sealed to the taker's certificate, and the nodes it will hand over",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "sealed": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string"
        },
        "epk": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "ct": {
          "type": "string"
        }
      },
      "required": [
        "alg",
        "epk",
        "nonce",
        "ct"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "how": {
            "type": "string",
            "enum": [
              "repin",
              "release",
              "own",
              "stays"
            ]
          },
          "why": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "handed",
              "failed"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "alias",
          "how",
          "why"
        ],
        "additionalProperties": false,
        "description": "repin: its owner pin handed to the new controller; release: the new controller's own machine, read over its loopback; own: this controller's own machine, its agent handed on with its LAN address; stays: not moved, with why"
      }
    },
    "expires_at": {
      "type": "number"
    }
  },
  "required": [
    "contract_version",
    "id",
    "sealed",
    "nodes",
    "expires_at"
  ],
  "additionalProperties": false
}
