{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/discovery.schema.json",
  "title": "GET /v1/fleet/discovery[?since=<cursor>], POST /v1/fleet/discovery, POST and DELETE /v1/fleet/discovery/scan (200): the devices found and each source's state",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "run": {
      "type": "integer",
      "description": "the run: each POST /v1/fleet/discovery starts a new one"
    },
    "cursor": {
      "type": "integer",
      "description": "send it back as ?since= for the rows changed after it"
    },
    "full": {
      "type": "boolean",
      "description": "true: `rows` is the whole list (no since, or a since from an earlier run); false: only the rows changed after `since`"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "stable while its strongest key stays: the node id, else the SSH host key, else the first address"
          },
          "kind": {
            "type": "string",
            "enum": [
              "spark",
              "gb10",
              "host",
              "owned",
              "unknown"
            ],
            "description": "spark: TandemNode answered (Spark with TandemLLM x.y); gb10: a GB10 box by its DMI, nothing installed; host: not a Spark; owned: a Spark another TandemApp owns; unknown"
          },
          "title": {
            "type": "string",
            "description": "the kind in words: 'Spark with TandemLLM 0.15.0', 'GB10 box, nothing installed', 'Linux host, not a Spark', 'Spark owned by another TandemApp', 'Unknown device'"
          },
          "detail": {
            "type": "string",
            "description": "the device and its state in words"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "the mDNS name or the ~/.ssh/config alias"
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mdns",
                "scan",
                "ssh_config",
                "address",
                "login",
                "pair"
              ]
            }
          },
          "node": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "class": {
                "type": "string"
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hw": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "paired": {
                "type": "boolean"
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "this",
                  "other",
                  null
                ]
              },
              "listen": {
                "type": "string"
              },
              "window": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "port": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "virtual": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "class",
              "version",
              "hw",
              "paired",
              "owner",
              "listen",
              "window",
              "port",
              "virtual"
            ],
            "additionalProperties": false,
            "description": "what its TandemNode says over mDNS (TXT); null without one"
          },
          "hw": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "spark": {
                "type": "boolean"
              },
              "source": {
                "type": "string",
                "enum": [
                  "mdns",
                  "dmi"
                ]
              }
            },
            "required": [
              "label",
              "spark",
              "source"
            ],
            "additionalProperties": false,
            "description": "the box by its DMI: over mDNS (the node's own word) or read in an SSH login"
          },
          "ssh": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "port": {
                "type": "integer"
              },
              "banner": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "os": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "host_key": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "port",
              "banner",
              "os",
              "host_key"
            ],
            "additionalProperties": false,
            "description": "its SSH server: the banner it sent first, the OS it says, the host key known_hosts or the TXT has"
          },
          "ssh_config": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "alias": {
                "type": "string"
              },
              "hostname": {
                "type": "string"
              },
              "user": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "port": {
                "type": "integer"
              },
              "identity_file": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "proxy_jump": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "alias",
              "hostname",
              "user",
              "port",
              "identity_file",
              "proxy_jump"
            ],
            "additionalProperties": false
          },
          "fleet": {
            "type": [
              "string",
              "null"
            ],
            "description": "the id of the fleet's node this is, null when it is not in the fleet"
          },
          "connect": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "code",
                "ssh",
                "takeover"
              ]
            },
            "description": "how the wizard's Connect step can reach it; empty for a node in the fleet or a host that is not a Spark"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "what each source said, in words"
          },
          "seen_at": {
            "type": "number"
          },
          "seq": {
            "type": "integer",
            "description": "the cursor at its last change"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "detail",
          "name",
          "addresses",
          "sources",
          "node",
          "hw",
          "ssh",
          "ssh_config",
          "fleet",
          "connect",
          "evidence",
          "seen_at",
          "seq"
        ],
        "additionalProperties": false
      }
    },
    "gone": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ids of rows that left since `since` (merged into another, or a new run)"
    },
    "mdns": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "browsing",
            "done",
            "denied",
            "failed"
          ]
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "started_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "found": {
          "type": "integer"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "types",
        "started_at",
        "ended_at",
        "found",
        "note"
      ],
      "additionalProperties": false
    },
    "scan": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "none",
            "ask",
            "running",
            "done",
            "stopped",
            "denied"
          ],
          "description": "none: no LAN; ask: `question` waits for the consent; denied: macOS keeps this app off the local network"
        },
        "subnet": {
          "type": [
            "string",
            "null"
          ]
        },
        "interface": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": [
            "string",
            "null"
          ],
          "description": "'Scan 192.0.2.0/24 for SSH?': the consent's POST /scan names this subnet"
        },
        "total": {
          "type": "integer"
        },
        "done": {
          "type": "integer"
        },
        "open": {
          "type": "integer"
        },
        "started_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "rate_per_s": {
          "type": "number"
        },
        "timeout_ms": {
          "type": "integer"
        },
        "by": {
          "type": [
            "string",
            "null"
          ],
          "description": "who said yes"
        }
      },
      "required": [
        "state",
        "subnet",
        "interface",
        "question",
        "total",
        "done",
        "open",
        "started_at",
        "ended_at",
        "rate_per_s",
        "timeout_ms",
        "by"
      ],
      "additionalProperties": false
    },
    "ssh_config": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "read",
            "none",
            "failed"
          ]
        },
        "hosts": {
          "type": "integer"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "hosts",
        "note"
      ],
      "additionalProperties": false
    },
    "local_network": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not_needed",
            "not_asked",
            "granted",
            "denied"
          ],
          "description": "macOS's Local Network permission for the controller; not_needed elsewhere"
        },
        "text": {
          "type": "string"
        },
        "settings": {
          "type": [
            "string",
            "null"
          ],
          "description": "where the user turns it on"
        }
      },
      "required": [
        "state",
        "text",
        "settings"
      ],
      "additionalProperties": false
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "subnet": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "address",
          "subnet"
        ],
        "additionalProperties": false
      },
      "description": "the LANs a scan can ask about, the default route's first"
    }
  },
  "required": [
    "contract_version",
    "run",
    "cursor",
    "full",
    "rows",
    "gone",
    "mdns",
    "scan",
    "ssh_config",
    "local_network",
    "interfaces"
  ],
  "additionalProperties": false
}
