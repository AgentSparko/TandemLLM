{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/error.schema.json",
  "title": "error body of every /v1/fleet/* endpoint",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "unauthorized",
            "bad_request",
            "not_found",
            "wrong_code",
            "code_spent",
            "owned",
            "conflict",
            "unreachable",
            "host_key_changed",
            "ssh_failed",
            "not_installed",
            "too_many",
            "not_managed",
            "busy",
            "no_agent",
            "not_rented",
            "not_built",
            "confirm_required",
            "confirm_invalid",
            "no_wire",
            "lan_denied",
            "host_key_unconfirmed",
            "secret_needed",
            "version_mismatch",
            "preflight_failed",
            "partial_split",
            "no_plan",
            "password_needed",
            "not_empty",
            "no_engine",
            "ambiguous_engine",
            "in_use",
            "exists",
            "no_space",
            "refused",
            "wrong_password",
            "cross_site",
            "cross_origin",
            "json_only",
            "too_large",
            "method_not_allowed",
            "not_a_node"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
