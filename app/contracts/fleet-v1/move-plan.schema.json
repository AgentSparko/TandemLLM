{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/move-plan.schema.json",
  "title": "GET /v1/fleet/controller/move?to=<node>&port=<p> (200): what a move of the controller to that Spark does, and its confirm",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "allowed": {
      "type": "boolean"
    },
    "blocked": {
      "type": [
        "string",
        "null"
      ]
    },
    "api_url": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keeps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "how": {
            "type": "string",
            "enum": [
              "repin",
              "release",
              "own",
              "stays"
            ]
          },
          "why": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "handed",
              "failed"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "alias",
          "how",
          "why"
        ],
        "additionalProperties": false,
        "description": "repin: its owner pin handed to the new controller; release: the new controller's own machine, read over its loopback; own: this controller's own machine, its agent handed on with its LAN address; stays: not moved, with why"
      }
    },
    "needs_password": {
      "type": "boolean",
      "description": "this controller has no admin password: the move asks for one, the new controller listens on the LAN"
    },
    "confirm": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "contract_version",
    "to",
    "title",
    "allowed",
    "blocked",
    "api_url",
    "port",
    "impact",
    "removes",
    "keeps",
    "nodes",
    "needs_password",
    "confirm",
    "expires_at"
  ],
  "additionalProperties": false
}
