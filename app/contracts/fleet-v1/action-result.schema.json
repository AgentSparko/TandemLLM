{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/action-result.schema.json",
  "title": "POST /v1/fleet/nodes/{id}/actions/{action} (200): done, or a job the node's agent runs",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "drain",
        "undrain",
        "restart-engine",
        "reboot",
        "update",
        "forget",
        "release-lease"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "done",
        "running"
      ]
    },
    "text": {
      "type": "string"
    },
    "job": {
      "type": [
        "object",
        "null"
      ],
      "description": "the agent's job for the action (an engine's restart, the machine's reboot or update), as the agent answers it"
    },
    "at": {
      "type": "number"
    }
  },
  "required": [
    "contract_version",
    "node",
    "action",
    "state",
    "text",
    "job",
    "at"
  ],
  "additionalProperties": false
}
