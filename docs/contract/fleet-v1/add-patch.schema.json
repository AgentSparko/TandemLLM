{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/add-patch.schema.json",
  "title": "the body of PATCH /v1/fleet/add/{id}: where the user is, and the Name step's drafts per target; step done applies them",
  "type": "object",
  "properties": {
    "step": {
      "enum": [
        "find",
        "connect",
        "check",
        "install",
        "link",
        "name",
        "done"
      ]
    },
    "names": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string"
          },
          "colour": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "icon": {
            "enum": [
              "desk",
              "cloud",
              "rack"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "minProperties": 1,
  "additionalProperties": false
}
