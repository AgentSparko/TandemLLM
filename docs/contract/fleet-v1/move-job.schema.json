{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/move-job.schema.json",
  "title": "a controller move's job (push: to a Spark; pull: taken from another controller; give: handed to one)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "const": "move"
    },
    "direction": {
      "type": "string",
      "enum": [
        "push",
        "pull",
        "give"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "running",
        "done",
        "failed"
      ]
    },
    "by": {
      "type": "string"
    },
    "started_at": {
      "type": "number"
    },
    "ended_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false
    },
    "log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "t",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "api_url": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "alias": {
                "type": "string"
              },
              "how": {
                "type": "string",
                "enum": [
                  "repin",
                  "release",
                  "own",
                  "stays"
                ]
              },
              "why": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "handed",
                  "failed"
                ]
              },
              "accepted": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "alias",
              "how",
              "why"
            ],
            "additionalProperties": false,
            "description": "repin: its owner pin handed to the new controller; release: the new controller's own machine, read over its loopback; own: this controller's own machine, its agent handed on with its LAN address; stays: not moved, with why"
          }
        }
      },
      "required": [
        "api_url",
        "nodes"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "todo",
              "running",
              "done",
              "failed"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "state",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "to": {
      "type": "string"
    },
    "alias": {
      "type": "string"
    },
    "api_url": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "url": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "how": {
            "type": "string",
            "enum": [
              "repin",
              "release",
              "own",
              "stays"
            ]
          },
          "why": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "handed",
              "failed"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "alias",
          "how",
          "why"
        ],
        "additionalProperties": false,
        "description": "repin: its owner pin handed to the new controller; release: the new controller's own machine, read over its loopback; own: this controller's own machine, its agent handed on with its LAN address; stays: not moved, with why"
      }
    },
    "old_refused": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "direction",
    "state",
    "by",
    "started_at",
    "ended_at",
    "error",
    "log",
    "result",
    "steps",
    "api_url",
    "nodes"
  ],
  "additionalProperties": false
}
