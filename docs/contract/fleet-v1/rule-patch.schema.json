{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/rule-patch.schema.json",
  "title": "PATCH /v1/fleet/rules/{id}: the body, any of these",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "notify": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "app",
          "system"
        ]
      }
    },
    "threshold": {
      "type": "number"
    },
    "for_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400
    },
    "scope": {
      "type": "string"
    }
  },
  "minProperties": 1,
  "additionalProperties": false
}
