{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/metrics.schema.json",
  "title": "GET /v1/fleet/metrics?source=&metric=&range= (200): one metric per node; the page aggregates",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "source": {
      "type": "string"
    },
    "metric": {
      "type": "string",
      "enum": [
        "tps",
        "req",
        "ttft",
        "gpu",
        "power",
        "temp",
        "sm",
        "memclk",
        "mem",
        "cpu",
        "disk",
        "lan",
        "fabric",
        "rtt"
      ]
    },
    "unit": {
      "type": "string"
    },
    "agg": {
      "type": "string",
      "enum": [
        "sum",
        "mean",
        "max",
        "maxmean"
      ]
    },
    "range": {
      "type": "string",
      "enum": [
        "5m",
        "1h",
        "6h",
        "24h",
        "7d",
        "30d"
      ]
    },
    "step_s": {
      "type": "number"
    },
    "t0": {
      "type": "number"
    },
    "cap": {
      "type": [
        "number",
        "null"
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "required": [
          "node",
          "values"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "source",
    "metric",
    "unit",
    "agg",
    "range",
    "step_s",
    "t0",
    "cap",
    "series"
  ],
  "additionalProperties": false
}
