{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/logs.schema.json",
  "title": "GET /v1/fleet/logs?node=all|<id>&level=&q=&limit= (200): the latest lines of the nodes' logs, oldest first",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "node": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number"
          },
          "node": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ]
          },
          "source": {
            "type": "string"
          },
          "msg": {
            "type": "string"
          }
        },
        "required": [
          "t",
          "node",
          "level",
          "source",
          "msg"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "node",
    "lines"
  ],
  "additionalProperties": false
}
