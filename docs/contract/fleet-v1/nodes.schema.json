{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/nodes.schema.json",
  "title": "GET /v1/fleet/nodes (200): every paired Spark",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "colour": {
            "type": "integer",
            "minimum": 1
          },
          "icon": {
            "type": "string",
            "enum": [
              "desk",
              "cloud",
              "rack"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "class": {
            "type": "string",
            "enum": [
              "spark"
            ]
          },
          "hw": {
            "type": "string"
          },
          "dmi": {
            "type": "string"
          },
          "owned": {
            "type": "boolean"
          },
          "transport": {
            "type": "string",
            "enum": [
              "lan",
              "tunnel"
            ]
          },
          "address": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "up",
              "draining",
              "off",
              "alert"
            ]
          },
          "status_text": {
            "type": "string"
          },
          "since": {
            "type": "number"
          },
          "lease_end": {
            "type": [
              "number",
              "null"
            ]
          },
          "cost_per_hour": {
            "type": [
              "number",
              "null"
            ]
          },
          "inventory": {
            "type": "object",
            "properties": {
              "serial": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "os": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kernel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "driver": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cuda": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cx7": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "disk": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nics": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "serial",
              "os",
              "kernel",
              "driver",
              "cuda",
              "cx7",
              "disk",
              "nics"
            ],
            "additionalProperties": false
          },
          "pairing": {
            "type": "object",
            "description": "how the controller trusts the node (SEC-4): this machine, paired by code or SSH once, or not paired yet",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "local",
                  "paired",
                  "unpaired"
                ]
              },
              "via": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "code",
                  "ssh",
                  null
                ]
              },
              "fingerprint": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "SHA-256 of the node's pinned certificate, hex"
              },
              "paired_at": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "host_key": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "the SSH host key's fingerprint (SHA256:...) a pairing by SSH confirmed"
              }
            },
            "required": [
              "state",
              "via",
              "fingerprint",
              "paired_at",
              "host_key"
            ],
            "additionalProperties": false
          },
          "drain": {
            "type": [
              "object",
              "null"
            ],
            "description": "maintenance (VIS-250): no new requests through the gateway; `draining` while requests are in flight, then `drained`; null when the node takes requests",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "draining",
                  "drained"
                ]
              },
              "since": {
                "type": "number"
              },
              "by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inflight": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "state",
              "since",
              "by",
              "inflight"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "alias",
          "colour",
          "icon",
          "tags",
          "class",
          "hw",
          "dmi",
          "owned",
          "transport",
          "address",
          "version",
          "status",
          "status_text",
          "since",
          "lease_end",
          "cost_per_hour",
          "inventory",
          "pairing",
          "drain"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "nodes"
  ],
  "additionalProperties": false
}
