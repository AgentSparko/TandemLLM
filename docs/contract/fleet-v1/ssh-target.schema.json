{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/ssh-target.schema.json",
  "title": "POST /v1/fleet/discovery/target (200): the ssh line as a target, its route from this controller through each jump host to the node, and what was not used",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "properties": {
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "identity_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "jumps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              }
            },
            "required": [
              "user",
              "host",
              "port"
            ],
            "additionalProperties": false
          }
        },
        "route": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "jump",
                  "node"
                ]
              },
              "user": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "user",
              "host",
              "port"
            ],
            "additionalProperties": false
          },
          "description": "the hops in order, the node last"
        },
        "remote": {
          "type": "boolean",
          "description": "a global address, a DNS name or a jump host: reached over SSH, never found on the LAN"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "options and a remote command the line had that are not used"
        }
      },
      "required": [
        "user",
        "host",
        "port",
        "identity_file",
        "jumps",
        "route",
        "remote",
        "warnings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "target"
  ],
  "additionalProperties": false
}
