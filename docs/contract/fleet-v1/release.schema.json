{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/release.schema.json",
  "title": "DELETE /v1/fleet/nodes/{id}[?force=1] (200): the node released; `node` says what its side did",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "node": {
      "type": "string",
      "enum": [
        "unpinned",
        "unreachable",
        "refused",
        "not_paired"
      ]
    }
  },
  "required": [
    "contract_version",
    "id",
    "node"
  ],
  "additionalProperties": false
}
