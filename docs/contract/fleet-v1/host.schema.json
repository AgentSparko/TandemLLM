{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/host.schema.json",
  "title": "GET /v1/fleet/host (200): the machine the controller runs on, the controller's own process, and the node it is when it is one",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "name": {
      "type": "string"
    },
    "os": {
      "type": [
        "string",
        "null"
      ]
    },
    "address": {
      "type": "string"
    },
    "node": {
      "description": "the node id of this machine when it is a node (a Spark running the controller), else null",
      "type": [
        "string",
        "null"
      ]
    },
    "may_sleep": {
      "type": "boolean"
    },
    "cpu": {
      "type": "object",
      "properties": {
        "util": {
          "type": [
            "number",
            "null"
          ]
        },
        "cores": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "util",
        "cores"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "used_gib": {
          "type": [
            "number",
            "null"
          ]
        },
        "total_gib": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "used_gib",
        "total_gib"
      ],
      "additionalProperties": false
    },
    "controller": {
      "type": "object",
      "properties": {
        "rss_mib": {
          "type": [
            "number",
            "null"
          ]
        },
        "cpu": {
          "type": [
            "number",
            "null"
          ]
        },
        "threads": {
          "type": "integer"
        },
        "uptime_s": {
          "type": "number"
        }
      },
      "required": [
        "rss_mib",
        "cpu",
        "threads",
        "uptime_s"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "name",
    "os",
    "address",
    "node",
    "may_sleep",
    "cpu",
    "memory",
    "controller"
  ],
  "additionalProperties": false
}
