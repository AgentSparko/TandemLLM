{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/controller.schema.json",
  "title": "GET /v1/fleet/controller (200): where the controller runs, its API URL, the Sparks it may move to, the last move, and where it moved to",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "mac",
            "linux",
            "spark"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "may_sleep": {
          "type": "boolean"
        },
        "address": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "os",
        "kind",
        "node",
        "may_sleep",
        "address"
      ],
      "additionalProperties": false
    },
    "api_url": {
      "type": "string"
    },
    "moved_to": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "api_url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "number"
        }
      },
      "required": [
        "api_url",
        "name",
        "fingerprint",
        "at"
      ],
      "additionalProperties": false,
      "description": "set once the controller moved: the page follows to api_url"
    },
    "sleep_warning": {
      "type": [
        "string",
        "null"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "allowed": {
            "type": "boolean"
          },
          "why": {
            "type": [
              "string",
              "null"
            ]
          },
          "virtual": {
            "type": "boolean"
          }
        },
        "required": [
          "node",
          "alias",
          "allowed",
          "why",
          "virtual"
        ],
        "additionalProperties": false
      }
    },
    "job": {
      "type": [
        "object",
        "null"
      ],
      "description": "the last job (move-job.schema.json), null before the first"
    }
  },
  "required": [
    "contract_version",
    "host",
    "api_url",
    "moved_to",
    "sleep_warning",
    "targets",
    "job"
  ],
  "additionalProperties": false
}
