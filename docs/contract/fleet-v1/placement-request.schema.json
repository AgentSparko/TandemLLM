{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/placement-request.schema.json",
  "title": "The body of POST /v1/fleet/placement: a Setup Guide model, one of its packs, the context a lane holds, the lanes and the nodes (in pipeline order for a Split)",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "pack": {
      "type": "string",
      "minLength": 1
    },
    "ctx": {
      "type": "integer",
      "minimum": 1
    },
    "slots": {
      "type": "integer",
      "minimum": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "model",
    "pack",
    "ctx"
  ],
  "additionalProperties": false
}
