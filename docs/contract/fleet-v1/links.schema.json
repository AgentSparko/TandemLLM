{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/links.schema.json",
  "title": "GET /v1/fleet/links (200): management, WAN and fabric links",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "lan",
              "wan",
              "fabric"
            ]
          },
          "speed": {
            "type": "string"
          },
          "rtt_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "mtu": {
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "up",
              "degraded",
              "down"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "test": {
            "type": "object",
            "properties": {
              "gbps": {
                "type": "number"
              },
              "at": {
                "type": "number"
              }
            },
            "required": [
              "gbps",
              "at"
            ],
            "additionalProperties": false
          },
          "roce": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ]
          },
          "interfaces": {
            "type": "object",
            "properties": {
              "up": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            },
            "required": [
              "up",
              "total"
            ],
            "additionalProperties": false
          },
          "port": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "a",
          "b",
          "kind",
          "speed",
          "rtt_ms",
          "mtu",
          "state",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "links"
  ],
  "additionalProperties": false
}
