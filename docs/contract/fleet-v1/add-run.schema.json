{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/add-run.schema.json",
  "title": "the body of POST /v1/fleet/add/{id}/check and /install: a password or key per target again when the session no longer holds it, the targets to check, the install's options per target",
  "type": "object",
  "properties": {
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string"
          },
          "state_dir": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "unit": {
            "type": "string"
          },
          "virtual": {
            "type": "string"
          },
          "engine": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
