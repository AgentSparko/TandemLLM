{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/discovery-address.schema.json",
  "title": "the body of POST /v1/fleet/discovery/address: one device by its address (add by address); its SSH banner and the agent's ports are read, nothing else",
  "type": "object",
  "properties": {
    "address": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  },
  "required": [
    "address"
  ],
  "additionalProperties": false
}
