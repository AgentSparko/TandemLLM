{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/add-connect.schema.json",
  "title": "the body of POST /v1/fleet/add/{id}/targets/{tid}/connect: the pairing code, or SSH with the confirmed host key and a password, a key, a key file on the controller's machine or the user's agent",
  "type": "object",
  "properties": {
    "method": {
      "enum": [
        "code",
        "ssh",
        "takeover"
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "user": {
      "type": "string"
    },
    "password": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "key_file": {
      "type": "string"
    },
    "agent": {
      "type": "boolean"
    },
    "host_key": {
      "type": "string"
    }
  },
  "required": [
    "method"
  ],
  "additionalProperties": false
}
