{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/events.schema.json",
  "title": "GET /v1/fleet/events?since= (200): the fleet timeline, newest first",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "alert",
              "failover",
              "deploy",
              "link",
              "weights",
              "node",
              "update"
            ]
          },
          "severity": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "warn",
              "err",
              "resolved",
              null
            ]
          },
          "node": {
            "type": "string"
          },
          "deployment": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "at",
          "type",
          "severity",
          "node",
          "deployment",
          "text",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "events"
  ],
  "additionalProperties": false
}
