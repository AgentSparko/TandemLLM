{
 "type": "object",
 "properties": {
  "pair": {
   "const": "engine-pair-v1"
  },
  "code": {
   "type": "string",
   "pattern": "^[0-9]{6}$"
  },
  "expires_in": {
   "type": "integer"
  },
  "tries": {
   "type": "integer"
  },
  "fingerprint": {
   "type": "string",
   "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
  },
  "host_key_type": {
   "type": "string"
  },
  "addresses": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "port": {
   "type": "integer"
  },
  "host": {
   "type": "string"
  },
  "mode": {
   "enum": [
    "setup",
    "engine"
   ]
  },
  "ssh_user": {
   "type": "string"
  },
  "ssh_port": {
   "type": "integer"
  },
  "lan": {
   "type": "boolean"
  }
 },
 "required": [
  "pair",
  "code",
  "expires_in",
  "tries",
  "fingerprint",
  "host_key_type",
  "addresses",
  "port",
  "host",
  "mode",
  "ssh_user",
  "ssh_port",
  "lan"
 ],
 "additionalProperties": false,
 "$id": "engine-pair-v1/open"
}
