{
 "type": "object",
 "properties": {
  "ctl": {
   "const": "engine-ctl-v1"
  },
  "version": {
   "type": "string",
   "pattern": "^1\\.[0-9]+$"
  },
  "engine_version": {
   "type": [
    "string",
    "null"
   ]
  },
  "verb": {
   "const": "status"
  },
  "ok": {
   "const": true
  },
  "engine": {
   "type": "object",
   "properties": {
    "state": {
     "enum": [
      "healthy",
      "loading",
      "draining",
      "failed",
      "down"
     ]
    },
    "pid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "port": {
     "type": "integer"
    },
    "health_code": {
     "type": [
      "integer",
      "null"
     ]
    },
    "engine_api": {
     "type": [
      "string",
      "null"
     ]
    },
    "version": {
     "type": [
      "string",
      "null"
     ]
    },
    "model": {
     "type": [
      "string",
      "null"
     ]
    },
    "running_mode": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "engine",
      "chat",
      null
     ]
    },
    "stopped_on_purpose": {
     "type": "boolean"
    }
   },
   "required": [
    "state",
    "pid",
    "port",
    "health_code",
    "engine_api",
    "version",
    "model",
    "running_mode",
    "stopped_on_purpose"
   ],
   "additionalProperties": false
  },
  "mode": {
   "type": [
    "string",
    "null"
   ]
  },
  "profile": {
   "type": [
    "string",
    "null"
   ]
  },
  "engine_api": {
   "type": "string"
  },
  "install": {
   "type": "boolean"
  },
  "overlay": {
   "type": "object",
   "properties": {
    "current": {
     "type": "integer"
    },
    "good": {
     "type": [
      "integer",
      "null"
     ]
    },
    "versions": {
     "type": "integer"
    },
    "file": {
     "type": "boolean"
    }
   },
   "required": [
    "current",
    "good",
    "versions",
    "file"
   ],
   "additionalProperties": false
  },
  "hook": {
   "type": "boolean"
  },
  "job": {
   "type": [
    "object",
    "null"
   ]
  },
  "status_file": {
   "type": "object"
  },
  "config_error": {
   "type": "string"
  },
  "http": {
   "type": "object",
   "properties": {
    "token": {
     "type": "boolean"
    },
    "allow_from": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "token",
    "allow_from"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "ctl",
  "version",
  "verb",
  "ok",
  "engine",
  "engine_version",
  "mode",
  "engine_api",
  "install",
  "overlay",
  "hook",
  "job"
 ],
 "additionalProperties": false,
 "$id": "engine-ctl-v1/status"
}
