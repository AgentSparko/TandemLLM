  "app_routes_via_engine": [
    {
      "path": "/v1/conductor/*",
      "contract": "../conductor-v1/",
      "doc": "TandemApp's conductor, run in the engine's process",
      "after_eng413": "extension",
      "why": "served only by an engine extension that registers it (engine-ext-v1); a headless engine answers 404"
    },
    {
      "path": "/v1/dashboard/session",
      "contract": "dashboard/session.schema.json",
      "doc": "the dashboard's sign-in",
      "after_eng413": "leaves",
      "why": "the page's cookie sign-in leaves with the page (2026-11-13); the engine keeps the bearer token and the loopback rule. Still served in 1.8: it goes with the cookie rule of server/api/auth.py, in a later minor (planned)"
    },
    {
      "path": "/v1/library*",
      "contract": "../conductor-v1/",
      "doc": "the package library (library.schema.json)",
      "after_eng413": "extension",
      "why": "served only by an engine extension that registers it (engine-ext-v1); a headless engine answers 404"
    },
    {
      "path": "/v1/laya*",
      "contract": "../conductor-v1/",
      "doc": "Laya (laya-ask.schema.json)",
      "after_eng413": "extension",
      "why": "served only by an engine extension that registers it (engine-ext-v1); a headless engine answers 404"
    },
    {
      "path": "/v1/memory",
      "contract": null,
      "doc": "the model's own memory, under its session's address",
      "after_eng413": "extension",
