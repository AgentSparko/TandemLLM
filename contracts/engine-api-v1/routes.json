    },
    {
      "path": "/v1/memory/*",
      "contract": null,
      "doc": "the model's own memory, under its session's address",
      "after_eng413": "extension",
      "why": "served only by an engine extension that registers it (engine-ext-v1); a headless engine answers 404"
    },
    {
      "path": "/s/{token}/*",
      "contract": null,
      "doc": "a session address: /v1/library, /v1/laya and /v1/memory under the session's token (tandemapp/session_tokens.py)",
      "after_eng413": "extension",
      "why": "served only by an engine extension that registers it (engine-ext-v1); a headless engine answers 404"
    }
  ],
